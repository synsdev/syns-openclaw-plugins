{
  "name": "@syns/openclaw-syns",
  "version": "0.2.1",
  "description": "Pull a Syns repository before every OpenClaw agent turn and sync it when the turn finishes, scoped to directories containing a .syns.yaml.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1",
      "pluginSdkVersion": "2026.7.1"
    }
  },
  "keywords": [
    "openclaw",
    "syns",
    "version-control",
    "multi-agent",
    "automation",
    "hooks",
    "auto-commit"
  ],
  "author": {
    "name": "Bartosz Sojka",
    "email": "bartsoj@gmail.com",
    "url": "https://syns.dev"
  },
  "homepage": "https://syns.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/synsdev/syns-openclaw-plugins.git",
    "directory": "plugins/syns"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
